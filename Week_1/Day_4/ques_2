class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        int n = mat.length;
        int m = mat[0].length;
        int [][] reshaped = new int[r][c];

        if( m*n != r*c) return mat;

       int col = 0, row = 0;

       for(int i=0; i<n; i++){
        for(int j=0; j<m; j++){
            reshaped[row][col] = mat[i][j];
            col++;

            if(col == c){
                col=0;
                row++;
            }

        }
       }
        return reshaped;
    }
}