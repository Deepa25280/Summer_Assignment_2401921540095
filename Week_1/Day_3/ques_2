class Solution {
    public int[] sortedSquares(int[] nums) {
        int n = nums.length;
        int[] res = new int[n];
        int start = 0 , end = n - 1;;
        int i = n - 1;

        while (start <= end) {
            int startSq = nums[start] * nums[start];
            int endSq = nums[end] * nums[end];

            if (startSq < endSq) {
                res[i] = endSq;
                end--;

            } else {
                res[i] = startSq;
                start++;
            }

            i--;
        }
        
        return res;
    }
}