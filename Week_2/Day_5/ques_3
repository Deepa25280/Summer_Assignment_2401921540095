class Solution {
    public String longestPalindrome(String s) {
        int st = 0, mx = 1;

        for (int i = 0; i < s.length(); i++) {
            int a = len(s, i, i);
            int b = len(s, i, i + 1);

            int cur = Math.max(a, b);

            if (cur > mx) {
                mx = cur;
                st = i - (cur - 1) / 2;
            }
        }

        return s.substring(st, st + mx);
    }

    private int len(String s, int l, int r) {
        while (l >= 0 && r < s.length() && s.charAt(l) == s.charAt(r)) {     
            l--;
            r++;
        }

        return r - l - 1;
    }
}
   
